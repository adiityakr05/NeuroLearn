# ==============================================================================
# NeuroLearn Frontend Production Environment Configuration Template
# Copy this file to .env.production or configure in Vercel project settings.
# ==============================================================================

# Public API URL pointing to the deployed production FastAPI backend
VITE_API_BASE_URL=https://neurolearn-api.onrender.com/api

# Strict Mock Mode Overrides for Production:
# All mock toggles MUST be explicitly set to 'false' to guarantee live API communication.
VITE_MOCK_AUTH=false
VITE_MOCK_USER=false
VITE_MOCK_DASHBOARD=false
VITE_MOCK_SUBJECTS=false
VITE_MOCK_PLANNER=false
VITE_MOCK_ANALYTICS=false
VITE_MOCK_RECOMMENDATIONS=false
VITE_MOCK_DIAGNOSTIC=false
