# NeuroLearn Frontend Environment Configuration Template
# Copy this file to .env.local to customize your development environment

# Base URL pointing to the FastAPI backend server
VITE_API_BASE_URL=http://localhost:8000/api

# Granular Mock / Real API Toggles
# Set to 'false' to switch a specific module to real backend API calls.
# Defaults to 'true' (mock mode) if unset.
VITE_MOCK_AUTH=true
VITE_MOCK_USER=true
VITE_MOCK_DASHBOARD=true
VITE_MOCK_SUBJECTS=true
VITE_MOCK_PLANNER=true
VITE_MOCK_ANALYTICS=true
VITE_MOCK_RECOMMENDATIONS=true
VITE_MOCK_DIAGNOSTIC=true
