# ==============================================================================
# NeuroLearn Backend Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Application Details
PROJECT_NAME="NeuroLearn API"
VERSION="0.1.0"
API_V1_STR="/api"

# Environment Mode: "development", "staging", "production", "test"
# In production, set to "production" (enforces strict security validation).
ENVIRONMENT=development

# Debug Mode:
# MUST be set to false in production. If ENVIRONMENT=production, startup fails if DEBUG=true.
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Authentication & JWT Secrets
# In development, a default fallback is accepted.
# In PRODUCTION, JWT_SECRET is MANDATORY, cannot be the dev fallback, and must be at least 32 bytes!
# Generate a cryptographically secure key:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=neurolearn_insecure_dev_secret_change_in_production_key_32bytes
JWT_ALGORITHM=HS256

# Access Token Lifetime:
# Development default: 10080 minutes (7 days for local convenience)
# Recommended production: 60 - 120 minutes
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Origins (Comma-separated list or JSON array)
# Development: ["http://localhost:5173", "http://127.0.0.1:5173"]
# Production: Explicit production origins required (e.g. ["https://neurolearn.vercel.app"])
# Wildcard '*' is strictly prohibited in production when credentials are enabled.
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration
# Fallback to local SQLite for zero-setup development:
# SQLALCHEMY_DATABASE_URI=sqlite:///./neurolearn.db
# For PostgreSQL (production/staging):
# SQLALCHEMY_DATABASE_URI=postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
SQLALCHEMY_DATABASE_URI=sqlite:///./neurolearn.db

# Google Gemini AI Quiz Generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
