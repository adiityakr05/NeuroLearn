# ==============================================================================
# NeuroLearn Backend Environment Configuration Template
# Copy this file to .env and adjust values for your local development setup
# ==============================================================================

# Application Details
PROJECT_NAME="NeuroLearn API"
VERSION="0.1.0"
API_V1_STR="/api"
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Authentication & JWT Secrets
# To generate a production secret key:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=neurolearn_insecure_dev_secret_change_in_production_key_32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Origins (Comma-separated list or JSON array)
# Allows the React frontend to communicate with FastAPI
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration
# Fallback to local SQLite for zero-setup development:
# SQLALCHEMY_DATABASE_URI=sqlite:///./neurolearn.db
# For PostgreSQL (production/staging):
# SQLALCHEMY_DATABASE_URI=postgresql://postgres:postgres@localhost:5432/neurolearn
SQLALCHEMY_DATABASE_URI=sqlite:///./neurolearn.db
